--- !u!1001 &363772716
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 320968887}
    m_Modifications:
    - target: {fileID: 197834654859803449, guid: 7f11ab6c75367464d82dec4ef8f13e12, type: 3}
      propertyPath: m_Name
      value: Witus Grow Potion
      objectReference: {fileID: 0}
    - target: {fileID: 5903525129822887899, guid: 7f11ab6c75367464d82dec4ef8f13e12, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5903525129822887899, guid: 7f11ab6c75367464d82dec4ef8f13e12, type: 3}
      propertyPath: dialogueLines.Array.data[0].text
      value: "Mikstura ro\u015Bni\u0119cia doda ci kilka centymetr\xF3w"
      objectReference: {fileID: 0}
    - target: {fileID: 5903525129822887899, guid: 7f11ab6c75367464d82dec4ef8f13e12, type: 3}
      propertyPath: dialogueLines.Array.data[1].text
      value: "\u017Beby ze mn\u0105 porozmawia\u0107, naci\u015Bnij przycisk 'E'"
      objectReference: {fileID: 0}
    - target: {fileID: 5903525129822887899, guid: 7f11ab6c75367464d82dec4ef8f13e12, type: 3}
      propertyPath: dialogueLines.Array.data[2].text
      value: "By zebra\u0107 checkpoint, r\xF3wnie\u017C naci\u015Bnij przycisk \"E\""
      objectReference: {fileID: 0}
    - target: {fileID: 5903525129822887899, guid: 7f11ab6c75367464d82dec4ef8f13e12, type: 3}
      propertyPath: dialogueLines.Array.data[3].text
      value: "Czy wiedzia\u0142e\u015B \u017Ce Walenie i Hipopotamy s\u0105 blisko
        spokrewnione? "
      objectReference: {fileID: 0}
    - target: {fileID: 5903525129822887899, guid: 7f11ab6c75367464d82dec4ef8f13e12, type: 3}
      propertyPath: dialogueLines.Array.data[4].text
      value: "Mikstura przy\u015Bpieszenia sprawi, \u017Ce zaczniesz biega\u0107.
        Ale tak szybko."
      objectReference: {fileID: 0}
    - target: {fileID: 5903525129822887899, guid: 7f11ab6c75367464d82dec4ef8f13e12, type: 3}
      propertyPath: dialogueLines.Array.data[0].voiceover
